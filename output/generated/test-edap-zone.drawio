          <mxGeometry x="1538" y="92" width="360" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lld-flow-index-text" value="&lt;b&gt;S1&lt;/b&gt;: Internet / User -&gt; API Gateway&lt;br/&gt;&lt;b&gt;S2&lt;/b&gt;: Application Service -&gt; Primary Data Store&lt;br/&gt;&lt;b&gt;S3&lt;/b&gt;: API Gateway -&gt; Application Service" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1538" y="112" width="360" height="76" as="geometry" />
        </mxCell>
        <mxCell id="lld-auth-bg" value="" style="rounded=1;fillColor=#FFFEEB;strokeColor=#9AA5B1;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry x="1528" y="268" width="380" height="240" as="geometry" />
        </mxCell>
        <mxCell id="lld-auth-title" value="Approved Identity Auth" style="text;fontSize=10;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1538" y="276" width="360" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lld-auth-text" value="&lt;b&gt;1.&lt;/b&gt; Human access via Entra ID / AWS IAM Identity Center + MFA&lt;br/&gt;&lt;b&gt;2.&lt;/b&gt; OIDC/OAuth2 token validation at entry points&lt;br/&gt;&lt;b&gt;3.&lt;/b&gt; Service-to-service mTLS inside Private Subnet&lt;br/&gt;&lt;b&gt;4.&lt;/b&gt; Workload identity (IAM Role / Managed Identity) for data access&lt;br/&gt;&lt;b&gt;5.&lt;/b&gt; RBAC/least-privilege authorization for intra-service calls&lt;br/&gt;&lt;b&gt;Observed from table:&lt;/b&gt; OIDC + MFA, Managed Identity, mTLS" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=8;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1538" y="296" width="360" height="208" as="geometry" />
        </mxCell>
        <mxCell id="lld-global-scope-bg" value="" style="rounded=1;fillColor=#ECFEFF;strokeColor=#0F766E;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry x="1528" y="528" width="400" height="140" as="geometry" />
        </mxCell>
        <mxCell id="lld-global-scope-title" value="Global-Scope Services" style="text;fontSize=10;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1538" y="536" width="380" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lld-global-scope-text" value="&lt;b&gt;1.&lt;/b&gt; API Gateway" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=8;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1538" y="556" width="380" height="104" as="geometry" />
        </mxCell>
        <mxCell id="lld-aws-rules-bg" value="" style="rounded=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry x="1528" y="676" width="380" height="230" as="geometry" />
        </mxCell>
        <mxCell id="lld-aws-rules-title" value="AWS Service Placement Rules" style="text;fontSize=10;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1538" y="684" width="360" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lld-aws-rules-text" value="&lt;b&gt;Global Services&lt;/b&gt; (no VPC boundary):&lt;br/&gt;&amp;#x25CF; S3, IAM, STS, CloudFront, Route53&lt;br/&gt;&amp;#x25CF; Accessible from any region/account&lt;br/&gt;&amp;#x25CF; Placed in: &lt;i&gt;AWS Managed Services&lt;/i&gt; zone&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Regional Managed Services&lt;/b&gt; (outside VPC):&lt;br/&gt;&amp;#x25CF; CloudWatch, KMS, Secrets Manager, DynamoDB&lt;br/&gt;&amp;#x25CF; SNS, SQS, CloudTrail (Audit Logging)&lt;br/&gt;&amp;#x25CF; Placed in: &lt;i&gt;AWS Managed Services&lt;/i&gt; zone&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Connectivity Rule&lt;/b&gt;:&lt;br/&gt;&amp;#x25CF; VPC resources access managed services&lt;br/&gt;&amp;#x25A0;  via &lt;b&gt;VPC Endpoints&lt;/b&gt; (no public internet)&lt;br/&gt;&amp;#x25A0;  Gateway Endpoint: S3, DynamoDB&lt;br/&gt;&amp;#x25A0;  Interface Endpoint: all others" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=8;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1538" y="704" width="360" height="196" as="geometry" />
        </mxCell>

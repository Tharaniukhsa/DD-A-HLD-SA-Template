          <mxGeometry x="20" y="454" width="1938" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lld-legend-text" value="Flow arrows are numbered. Each numbered step explains inbound path, request channel, auth, and outbound response path." style="text;fontSize=9;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" parent="1" vertex="1">

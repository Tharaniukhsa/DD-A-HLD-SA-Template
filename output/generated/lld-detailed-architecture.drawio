        <mxCell id="lld-global-scope-text" value="&lt;b&gt;1.&lt;/b&gt; Audit Logging &amp; Compliance Monitoring&lt;br/&gt;&lt;b&gt;2.&lt;/b&gt; Identity &amp; Access Management (IAM)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=8;strokeColor=none;fillColor=none;" parent="1" vertex="1">

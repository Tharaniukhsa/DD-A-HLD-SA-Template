        <mxCell id="lld-auth-title" value="Approved Identity Auth" style="text;fontSize=10;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1922" y="2008" width="360" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lld-auth-text" value="&lt;b&gt;1.&lt;/b&gt; Human access via Entra ID / AWS IAM Identity Center + MFA&lt;br/&gt;&lt;b&gt;2.&lt;/b&gt; OIDC/OAuth2 token validation at entry points&lt;br/&gt;&lt;b&gt;3.&lt;/b&gt; Service-to-service mTLS inside Private Subnet&lt;br/&gt;&lt;b&gt;4.&lt;/b&gt; Workload identity (IAM Role / Managed Identity) for data access&lt;br/&gt;&lt;b&gt;5.&lt;/b&gt; RBAC/least-privilege authorization for intra-service calls&lt;br/&gt;&lt;b&gt;Observed from table:&lt;/b&gt; IAM / SSE-KMS, IAM / KMS (UKHSA mandatory), SFTP, service account, SFTP over VPN, key auth, AWS internal, Policy API / config scan, GuardDuty/Defender integration, Pipeline policy checks, TLS, DB auth, IAM role, OIDC/OAuth2, IAM role, TLS + IAM auth, Metadata sync, Control evidence linkage, KMS/Key Vault policy, Log forwarding, CloudWatch, Cost Explorer / Cost Management API" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=8;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1922" y="2028" width="360" height="208" as="geometry" />
        </mxCell>

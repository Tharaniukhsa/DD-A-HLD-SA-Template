        </mxCell>
        <mxCell id="lld-flow-index-text" value="&lt;b&gt;S1&lt;/b&gt;: On-Prem Business App -&gt; On-Prem SFTP Server&lt;br/&gt;&lt;b&gt;S2&lt;/b&gt;: On-Prem SFTP Server -&gt; AWS Transfer Endpoint&lt;br/&gt;&lt;b&gt;S3&lt;/b&gt;: AWS Transfer Endpoint -&gt; Raw Landing Bucket&lt;br/&gt;&lt;b&gt;S4&lt;/b&gt;: Validation Processor -&gt; Curated Database&lt;br/&gt;&lt;b&gt;S5&lt;/b&gt;: Validation Processor -&gt; Processing Queue&lt;br/&gt;&lt;b&gt;S6&lt;/b&gt;: Validation Processor -&gt; Identity &amp; Access Management (IAM)&lt;br/&gt;&lt;b&gt;S7&lt;/b&gt;: Validation Processor -&gt; Secret Management&lt;br/&gt;&lt;b&gt;S8&lt;/b&gt;: Curated Database -&gt; Encryption at Rest &amp; Transit&lt;br/&gt;&lt;b&gt;S9&lt;/b&gt;: Monitoring and Alerts -&gt; Validation Processor&lt;br/&gt;&lt;b&gt;S10&lt;/b&gt;: Monitoring and Alerts -&gt; Processing Queue&lt;br/&gt;&lt;b&gt;S11&lt;/b&gt;: Raw Landing Bucket -&gt; Validation Processor" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1922" y="112" width="360" height="192" as="geometry" />
        </mxCell>
        <mxCell id="lld-auth-bg" value="" style="rounded=1;fillColor=#FFFEEB;strokeColor=#9AA5B1;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry x="1912" y="384" width="380" height="240" as="geometry" />
        </mxCell>
        <mxCell id="lld-auth-title" value="Approved Identity Auth" style="text;fontSize=10;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1922" y="392" width="360" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lld-auth-text" value="&lt;b&gt;1.&lt;/b&gt; Human access via Entra ID / AWS IAM Identity Center + MFA&lt;br/&gt;&lt;b&gt;2.&lt;/b&gt; OIDC/OAuth2 token validation at entry points&lt;br/&gt;&lt;b&gt;3.&lt;/b&gt; Service-to-service mTLS inside Private Subnet&lt;br/&gt;&lt;b&gt;4.&lt;/b&gt; Workload identity (IAM Role / Managed Identity) for data access&lt;br/&gt;&lt;b&gt;5.&lt;/b&gt; RBAC/least-privilege authorization for intra-service calls&lt;br/&gt;&lt;b&gt;Observed from table:&lt;/b&gt; SFTP, service account, SFTP over VPN, key auth, AWS internal, TLS, DB auth, IAM role, OIDC/OAuth2, IAM role, TLS + IAM auth, KMS/Key Vault policy, CloudWatch" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=8;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1922" y="412" width="360" height="208" as="geometry" />
        </mxCell>

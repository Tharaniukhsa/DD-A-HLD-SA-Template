        <mxCell id="dfd-l2-flow-0" value="F1. Magentus -&gt; Apollo Receiver (One-way)\nEncrypted patient data [HTTPS/SFTP]" style="fontSize=9;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=none;strokeColor=none;" parent="1" vertex="1">
          <mxGeometry x="1368" y="138" width="284" height="66" as="geometry" />
        </mxCell>
        <mxCell id="dfd-l2-flow-1" value="F2. Apollo Receiver -&gt; Decryption Service (One-way)\nEncrypted payload [Internal]" style="fontSize=9;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=none;strokeColor=none;" parent="1" vertex="1">
          <mxGeometry x="1368" y="208" width="284" height="66" as="geometry" />
        </mxCell>
        <mxCell id="dfd-l2-flow-2" value="F3. Decryption Service -&gt; S3 Storage (One-way)\nDecrypted dataset [HTTPS]" style="fontSize=9;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=none;strokeColor=none;" parent="1" vertex="1">
          <mxGeometry x="1368" y="278" width="284" height="66" as="geometry" />
        </mxCell>
        <mxCell id="dfd-l2-flow-3" value="F4. S3 Storage -&gt; EDAP ETL (One-way)\nStructured data ingestion [Private endpoint]" style="fontSize=9;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=none;strokeColor=none;" parent="1" vertex="1">
          <mxGeometry x="1368" y="348" width="284" height="66" as="geometry" />
        </mxCell>

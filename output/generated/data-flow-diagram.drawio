          <mxGeometry x="1368" y="418" width="284" height="66" as="geometry" />
        </mxCell>
        <mxCell id="dfd-l2-flow-5" value="DF-INF-02-01. On-Premises DC -&gt; AWS VPC (One-way)\nHybrid workload traffic [Direct Connect / BGP]" style="fontSize=9;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=none;strokeColor=none;" parent="1" vertex="1">
          <mxGeometry x="1368" y="488" width="284" height="66" as="geometry" />
        </mxCell>
        <mxCell id="dfd-l2-flow-6" value="DF-INF-05-01. User -&gt; AWS Console / CLI (One-way)\nFederated authentication token [SAML 2.0 / OIDC via Entra ID]" style="fontSize=9;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=none;strokeColor=none;" parent="1" vertex="1">
          <mxGeometry x="1368" y="558" width="284" height="66" as="geometry" />
        </mxCell>
        <mxCell id="dfd-l2-flow-7" value="DF-1B-01. External Source -&gt; Amazon S3 (Staging) (One-way)\nBulk files (CSV/JSON/Parquet) [SFTP / S3 API]" style="fontSize=9;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=none;strokeColor=none;" parent="1" vertex="1">
          <mxGeometry x="1368" y="628" width="284" height="66" as="geometry" />
        </mxCell>
        <mxCell id="dfd-l2-flow-8" value="DF-2A-01. Source Data Store -&gt; Target Data Store (One-way)\nTransformed dataset [Glue Spark Job]" style="fontSize=9;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=none;strokeColor=none;" parent="1" vertex="1">
          <mxGeometry x="1368" y="698" width="284" height="66" as="geometry" />
